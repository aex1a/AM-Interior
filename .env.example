# Copy this file to .env (local dev) and set these from your Supabase project.
# Settings -> API in your Supabase dashboard.
# These are safe to expose in a browser bundle (the anon key is public by
# design; real security comes from the Row Level Security policies in
# database/schema.sql).

VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
